# Copia este archivo como .env y completa los valores
# En Railway, configura estas variables en el dashboard (NO subas .env al repo)

# JWT — genera una clave segura con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_LARGA

# Puerto (Railway lo asigna automáticamente, no cambiar en producción)
PORT=5000

# Entorno
NODE_ENV=production

# URL del frontend (para CORS) — pon la URL de Vercel cuando la tengas
FRONTEND_URL=https://TU-APP.vercel.app
